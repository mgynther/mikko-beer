{
  "name": "mikko-beer-frontend",
  "version": "0.0.0",
  "type": "module",
  "author": "Mikko Gynther",
  "scripts": {
    "dev": "VITE_BACKEND_URL=http://localhost:3001 vite",
    "build": "./node_modules/@typescript/native/bin/tsc && vite build && mv dist/manifest.json dist/assets/manifest*.json",
    "build:watch": "./node_modules/@typescript/native/bin/tsc -w",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint --max-warnings=0 --fix .",
    "test": "VITE_BACKEND_URL=http://localhost:3001 TEST_PORT_START=35000 vitest --coverage.enabled false",
    "test:ci": "CI=true VITE_BACKEND_URL=http://localhost:3001 TEST_PORT_START=30000 vitest --coverage.enabled true",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "preview": "vite preview"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "async-mutex": "0.5.0",
    "fp-ts": "2.16.11",
    "io-ts": "2.2.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "9.3.0",
    "react-router": "8.4.0",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "30.1.0",
    "prettier": "3.9.7",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "web-vitals": "6.2.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
